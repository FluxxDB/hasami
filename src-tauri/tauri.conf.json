{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hasami",
  "version": "0.1.0",
  "identifier": "com.hasami.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "publisher": "FluxxDB",
    "copyright": "Copyright (c) 2026 FluxxDB and Hasami contributors",
    "homepage": "https://github.com/FluxxDB/hasami",
    "shortDescription": "Right-click video trim, compress and convert for Windows",
    "licenseFile": "../LICENSE-MIT",
    "resources": {
      "../LICENSE-MIT": "licenses/LICENSE-MIT.txt",
      "../LICENSE-APACHE": "licenses/LICENSE-APACHE.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES_RUST.md": "licenses/THIRD_PARTY_LICENSES_RUST.md",
      "../THIRD_PARTY_LICENSES_NPM.md": "licenses/THIRD_PARTY_LICENSES_NPM.md",
      "binaries/ffmpeg-LICENSE.txt": "licenses/ffmpeg/LICENSE.txt",
      "binaries/ffmpeg-README.txt": "licenses/ffmpeg/README.txt",
      "../src/lib/fonts/Inter-OFL.txt": "licenses/fonts/Inter-OFL.txt",
      "../src/lib/fonts/InstrumentSerif-OFL.txt": "licenses/fonts/InstrumentSerif-OFL.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
